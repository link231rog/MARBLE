# ==============================================================================
# MARBLE Benchmark Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Remote Worker & Evaluator (NVIDIA NIM Cloud API)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY="nvapi-your-key-here"
OPENAI_API_KEY="nvapi-your-key-here"
OPENAI_BASE_URL="https://integrate.api.nvidia.com/v1"
OPENAI_API_BASE="https://integrate.api.nvidia.com/v1"
MARBLE_WORKER_MODEL="openai/gpt-oss-20b"
MARBLE_EVAL_MODEL="openai/gpt-oss-20b"

# ------------------------------------------------------------------------------
# 2. Governed Controller API (Default: SiliconFlow Qwen3.5-4B Cloud API)
#    - 0 GPU VRAM footprint on local and server
#    - Sub-second latency (~0.35s)
# ------------------------------------------------------------------------------
MARBLE_QWEN_API_KEY="sk-your-siliconflow-key-here"
MARBLE_QWEN_API_BASE="https://api.siliconflow.cn/v1"
MARBLE_QWEN_API_MODEL="Qwen/Qwen3.5-4B"
MARBLE_CONTROLLER_DISABLE_THINKING="1"

# ------------------------------------------------------------------------------
# 3. Optional: Self-Hosted H20 / Remote vLLM Server Interface
#    (Keep interface available, but do NOT hard-launch or auto-start)
#    To use an H20 vLLM instance manually started by user:
#      Uncomment the lines below and point to the forwarded or direct endpoint.
# ------------------------------------------------------------------------------
# MARBLE_QWEN_API_BASE="http://127.0.0.1:8000/v1"
# MARBLE_QWEN_API_KEY="local-dummy"
# MARBLE_QWEN_API_MODEL="Qwen/Qwen3-4B-Instruct-2507"
# MARBLE_CONTROLLER_TIMEOUT="60.0"

# ------------------------------------------------------------------------------
# 4. Optional: Multi-Key Rotation for Parallel Execution (8 Workers)
# ------------------------------------------------------------------------------
# MARBLE_QWEN_API_KEYS="sk-key1,sk-key2,sk-key3,sk-key4"
# MARBLE_WORKER_API_KEYS="nvapi-key1,nvapi-key2"
